#!/bin/sh
# Block direct pushes to main or master; changes must go through a Pull Request.

while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/heads/main|refs/heads/master)
            echo "Bloqueado por .githooks/pre-push: no se permite hacer push directo a $remote_ref. Usa una rama y Pull Request." >&2
            exit 1
            ;;
    esac
done

exit 0
