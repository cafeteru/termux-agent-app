{
  "prevent-auto-merge": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/prevent_auto_merge.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "prevent-auto-pr": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/prevent_auto_pr.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
